.PHONY: check help install install-dev install-meetings install-no-deps uninstall clean format format-check lint typecheck test test-verbose coverage run

# Normalize HOME to forward slashes (no-op on Unix, fixes Windows backslashes)
HOME_DIR := $(subst \,/,$(HOME))

# Use shared ~/.venv/ap if it exists, otherwise local .venv
ifeq ($(OS),Windows_NT)
    VENV_DIR ?= $(if $(wildcard $(HOME_DIR)/.venv/ap/Scripts/python.exe),$(HOME_DIR)/.venv/ap,.venv)
    PYTHON := $(VENV_DIR)/Scripts/python.exe
else
    VENV_DIR ?= $(if $(wildcard $(HOME_DIR)/.venv/ap/bin/python),$(HOME_DIR)/.venv/ap,.venv)
    PYTHON := $(VENV_DIR)/bin/python
endif

$(info venv: $(VENV_DIR))

check: format lint typecheck test coverage  ## Run format, lint, typecheck, test, coverage (default)

.DEFAULT_GOAL := check

help:  ## Show available targets
	@grep -hE '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-15s\033[0m %s\n", $$1, $$2}'

$(PYTHON):
	python3 -m venv $(VENV_DIR)

install: $(PYTHON)  ## Install package
	$(PYTHON) -m pip install .

install-dev: $(PYTHON)  ## Install in editable mode with dev deps
	$(PYTHON) -m pip install -e ".[dev]"

install-meetings: $(PYTHON)  ## Install meet-enrich and meet-summarize from GitHub HEAD
	$(PYTHON) -m pip install --force-reinstall --no-deps "meet-enrich @ git+https://github.com/jewzaam/meet-enrich.git" "meet-summarize @ git+https://github.com/jewzaam/meet-summarize.git"

install-no-deps: $(PYTHON)  ## Install in editable mode without dependencies
	$(PYTHON) -m pip install -e . --no-deps

uninstall:  ## Uninstall package
	$(PYTHON) -m pip uninstall -y personal-assistant

clean:  ## Remove build artifacts and caches
	rm -rf build/ dist/ *.egg-info
	find . -type d -name __pycache__ -exec rm -r {} + 2>/dev/null || true
	find . -type f -name "*.pyc" -delete 2>/dev/null || true

format: install-dev  ## Format code with black
	$(PYTHON) -m black personal_assistant tests

format-check: install-dev  ## Check formatting without modifying files
	$(PYTHON) -m black --check personal_assistant tests

lint: install-dev  ## Lint with flake8
	$(PYTHON) -m flake8 --max-line-length=88 --extend-ignore=E203,W503 personal_assistant tests

typecheck: install-dev  ## Type check with mypy
	$(PYTHON) -m mypy personal_assistant

test: install-dev  ## Run pytest
	$(PYTHON) -m pytest

test-verbose: install-dev  ## Run pytest with verbose output
	$(PYTHON) -m pytest -v

coverage: install-dev  ## Run pytest with coverage
	$(PYTHON) -m pytest --cov=personal_assistant --cov-report=term

mutation: install-dev  ## Run mutation testing
	$(PYTHON) -m mutmut run --CI --paths-to-mutate "personal_assistant"

mutation-report:  ## Show results of last mutation run
	$(PYTHON) -m mutmut results

run: install install-meetings  ## Run the personal assistant GUI
	$(PYTHON) -m personal_assistant --debug gui --log-file pa-dashboard.log
